<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.18.xsd">

    <changeSet id="1" author="architect">
        <createTable tableName="pagos">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="socio_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="monto" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_pago" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="metodo_pago" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="estado_pago" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="descripcion" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>
    <changeSet id="insert-data-pagos" author="programacionxx">
